{
  "manifest_version": 3,
  "name": "Pangram Gallery",
  "version": "0.1.4",
  "description": "Replace Pangram-labeled AI feed posts with quiet public-domain art.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://collectionapi.metmuseum.org/*",
    "https://images.metmuseum.org/*",
    "https://api.artic.edu/*",
    "https://www.artic.edu/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Pangram Gallery",
    "default_popup": "src/options/options.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content-core.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
